# 华为运动健康 OAuth 配置（复制为 .env 填入真实值，.env 不提交）
# 在华为开发者联盟创建应用后获取
HW_CLIENT_ID=你的_client_id
HW_CLIENT_SECRET=你的_client_secret

# OAuth 回调地址：必须是 HTTPS，且需在华为开发者联盟后台登记为回调地址
# 部署后改为你的真实域名，例如 https://your-domain.com/api/health/callback
HW_REDIRECT_URI=https://your-domain.com/api/health/callback

# 服务监听端口（部署平台通常会注入 PORT，本地默认 3000）
PORT=3000

# AI 服务配置（密钥仅保存在后端环境变量，前端不再触碰）
# 默认使用哪个服务商：deepseek 或 doubao
AI_PROVIDER=deepseek
# DeepSeek API Key（可选，填了才启用 DeepSeek）
DEEPSEEK_API_KEY=sk-你的_deepseek_key
# 豆包/火山方舟 API Key（可选，填了才启用豆包）
DOUBAO_API_KEY=ark-你的_doubao_key
# 豆包模型端点 ID（ARK 控制台创建推理端点后获取，形如 ep-xxxxxxxx）
DOUBAO_ENDPOINT=ep-你的端点ID
