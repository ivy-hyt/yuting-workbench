# 华为运动健康 OAuth 配置（复制为 .env 填入真实值，.env 不提交）
# 在华为开发者联盟创建应用后获取
HW_CLIENT_ID=你的_client_id
HW_CLIENT_SECRET=你的_client_secret

# OAuth 回调地址：必须是 HTTPS，且需在华为开发者联盟后台登记为回调地址
# 部署后改为你的真实域名，例如 https://your-domain.com/api/health/callback
HW_REDIRECT_URI=https://your-domain.com/api/health/callback

# 服务监听端口（部署平台通常会注入 PORT，本地默认 3000）
PORT=3000

# AI 服务配置（密钥仅保存在后端环境变量，前端不再触碰）
# 默认使用哪个服务商：gemini / zhipu（智谱）/ deepseek / doubao
AI_PROVIDER=gemini
# Gemini API Key（在 https://aistudio.google.com/apikey 申请，以 AIza 开头）
GEMINI_API_KEY=AIza你的_gemini_key
# Gemini 模型名（新用户若 gemini-2.5-flash 报 404，改填 gemini-2.5-flash-lite 或 gemini-flash-latest）
GEMINI_MODEL=gemini-2.5-flash
# 智谱 API Key（open.bigmodel.cn 注册获取；GLM-4-Flash 永久免费）— 备选
ZHIPU_API_KEY=你的_智谱_key
# 智谱模型名，默认 glm-4-flash（也可填 glm-4.7-flash 等更新的免费模型）
ZHIPU_MODEL=glm-4-flash
# DeepSeek API Key（备选，填了才启用 DeepSeek）
DEEPSEEK_API_KEY=sk-你的_deepseek_key
# 豆包/火山方舟 API Key（备选，填了才启用豆包）
DOUBAO_API_KEY=ark-你的_doubao_key
# 豆包模型端点 ID（ARK 控制台创建推理端点后获取，形如 ep-xxxxxxxx）
DOUBAO_ENDPOINT=ep-你的端点ID
