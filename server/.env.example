# 华为运动健康 OAuth 配置（复制为 .env 填入真实值，.env 不提交）
# 在华为开发者联盟创建应用后获取
HW_CLIENT_ID=你的_client_id
HW_CLIENT_SECRET=你的_client_secret

# OAuth 回调地址：必须是 HTTPS，且需在华为开发者联盟后台登记为回调地址
# 部署后改为你的真实域名，例如 https://your-domain.com/api/health/callback
HW_REDIRECT_URI=https://your-domain.com/api/health/callback

# 服务监听端口（部署平台通常会注入 PORT，本地默认 3000）
PORT=3000
